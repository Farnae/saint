<div class="wrap subhead"><p class="eyebrow">{{ 'cart.eyebrow' | t }}</p><h1>{{ 'cart.title' | t }}</h1></div>
<div class="wrap" style="padding-bottom:180px;">
  {% if cart.item_count == 0 %}
    <div class="empty-cart">{{ 'cart.empty_text' | t }}<br><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ 'cart.view_collection' | t }}</a></div>
  {% else %}
    {% form 'cart', cart %}
      <div class="panier-list">
        {% for item in cart.items %}
          <div class="panier-row">
            <div class="p-thumb"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}"></div>
            <div>
              <h4>{{ item.product.title }}</h4>
              <p class="ptsubsub">{{ item.variant.title | unless: 'Default Title' }}</p>
              <a href="{{ item.url_to_remove }}" class="p-remove">{{ 'cart.remove' | t }}</a>
            </div>
            <div class="stepper cart-line-stepper" data-line-key="{{ item.key }}">
              <button type="button" data-step="down">&minus;</button>
              <span class="cart-qty-val">{{ item.quantity }}</span>
              <button type="button" data-step="up">+</button>
            </div>
            <div style="font-family:'Jost',sans-serif;">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
      <div class="panier-summary">
        <div class="panier-summary-box">
          <div class="sum-row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
          <div class="sum-row"><span>{{ 'cart.shipping' | t }}</span><span>{{ 'cart.shipping_value' | t }}</span></div>
          <div class="sum-row total"><span>{{ 'cart.total' | t }}</span><span>{{ cart.total_price | money }}</span></div>
          <button type="submit" name="checkout" class="btn-add-cart" style="width:100%;margin-top:24px;text-align:center;"><span>{{ 'cart.checkout' | t }}</span></button>
        </div>
      </div>
    {% endform %}
  {% endif %}
</div>
