<div class="wrap subhead">
  <p class="eyebrow">{{ 'collection.eyebrow' | t }}</p>
  <h1>{{ 'collection.title' | t }}</h1>
</div>
<section class="collection wrap">
  <div class="grid">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        <article class="card">
          <a class="card-link" href="{{ collection.url }}">
            <div class="card-visual">{%- if collection.featured_image -%}<img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.title | escape }}" loading="lazy">{%- elsif collection.products.first.featured_image -%}<img src="{{ collection.products.first.featured_image | image_url: width: 900 }}" alt="{{ collection.title | escape }}" loading="lazy">{%- endif -%}</div>
            <h3>{{ collection.title }}</h3>
          </a>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
