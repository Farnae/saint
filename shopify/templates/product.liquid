<div class="wrap produit-wrap">
  <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="back-link">&larr; {{ 'product.back_to_collection' | t }}</a>
  <div class="produit-layout">
    <div class="produit-visual">
      {% for image in product.images %}
        <div class="produit-photo"><img src="{{ image | image_url: width: 1400, format: 'webp' }}" alt="{{ product.title | escape }} &ndash; vue {{ forloop.index }}" loading="lazy"></div>
      {% endfor %}
    </div>
    <div class="produit-info">
      <div class="p-head">
        <div>
          <h1 class="p-name">{{ product.title }}</h1>
          <p class="p-sub">{% if product.type != blank %}{{ product.type }}{% else %}{{ 'product.sub_default' | t }}{% endif %}</p>
        </div>
        <button class="p-wish" type="button" aria-label="{{ 'product.wishlist_aria' | t }}" onclick="this.classList.toggle('active')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7.5-4.6-10-9.3C.5 8 2 4.5 5.5 4c2-.3 3.8.6 5 2.2C11.7 4.6 13.5 3.7 15.5 4c3.5.5 5 4 3.5 7.7-2.5 4.7-10 9.3-10 9.3z"/></svg>
        </button>
      </div>
      <p class="p-ref">{{ 'product.reference_label' | t }}&nbsp;: {{ product.selected_or_first_available_variant.sku | default: product.handle | upcase }}</p>

      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          <select name="id" style="display:block;margin-bottom:16px;">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title }}</option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}
        <input type="hidden" name="quantity" value="1">
        <div class="p-buy-bar">
          <button type="submit" class="btn-buy-bar" {% unless product.available %}disabled{% endunless %}>
            <span>{{ 'product.add_to_cart' | t }}</span>
            <span class="p-price">{{ product.price | money }}</span>
          </button>
          <p class="p-buy-status">{% if product.available %}{{ 'index.feature.preorder' | t }}{% else %}{{ 'index.feature.soldout' | t }}{% endif %}</p>
          <div class="p-pay-badges" aria-hidden="true">
            <span class="pay-badge" title="Apple Pay"><svg width="30" height="18" viewBox="0 0 30 18"><rect x=".5" y=".5" width="29" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1"/><text x="15" y="12" font-family="'DM Sans',sans-serif" font-size="7" text-anchor="middle" fill="currentColor">Pay</text></svg></span>
            <span class="pay-badge" title="Visa"><svg width="30" height="18" viewBox="0 0 30 18"><rect x=".5" y=".5" width="29" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1"/><text x="15" y="12" font-family="'DM Sans',sans-serif" font-weight="700" font-size="7" text-anchor="middle" fill="currentColor">VISA</text></svg></span>
            <span class="pay-badge" title="Mastercard"><svg width="30" height="18" viewBox="0 0 30 18"><rect x=".5" y=".5" width="29" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="12.5" cy="9" r="4.6" fill="currentColor" opacity=".55"/><circle cx="17.5" cy="9" r="4.6" fill="currentColor" opacity=".55"/></svg></span>
            <span class="pay-badge" title="{{ 'product.pay_in_installments' | t }}"><svg width="30" height="18" viewBox="0 0 30 18"><rect x=".5" y=".5" width="29" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1"/><text x="15" y="12" font-family="'DM Sans',sans-serif" font-weight="500" font-size="7" text-anchor="middle" fill="currentColor">3x</text></svg></span>
          </div>
        </div>
      {% endform %}

      <div class="p-express">
        <span>{{ 'product.express.preorder' | t }}</span><span class="p-express-sep">&middot;</span><span>{{ 'product.express.secure_payment' | t }}</span>
      </div>
      <p class="p-delivery">{{ 'product.delivery_estimate' | t }}</p>
      <p class="p-delivery p-freeship">{{ 'general.freeship_note' | t }}</p>

      <div class="p-tabs">
        <div class="p-tabs-nav">
          <button class="p-tab-btn active" data-tab="desc">{{ 'product.tabs.description' | t }}</button>
          <button class="p-tab-btn" data-tab="fit">{{ 'product.tabs.fit' | t }}</button>
          <button class="p-tab-btn" data-tab="care">{{ 'product.tabs.care' | t }}</button>
          <button class="p-tab-btn" data-tab="ship">{{ 'product.tabs.shipping' | t }}</button>
          <button class="p-tab-btn" data-tab="contact">{{ 'product.tabs.contact' | t }}</button>
        </div>
        <div class="p-tab-panel active" data-panel="desc">
          <div class="p-desc">{{ product.description }}</div>
        </div>
        <div class="p-tab-panel" data-panel="fit">
          <div class="spec-tiles">
            <div class="spec-tile"><span class="spec-tile-val" style="font-size:16px;line-height:1.3;">{{ 'product.spec_tiles.tile1_l1' | t }}<br>{{ 'product.spec_tiles.tile1_l2' | t }}</span><span class="spec-tile-lbl">{{ 'product.spec_tiles.tile1_label' | t }}</span></div>
            <div class="spec-tile"><span class="spec-tile-val" style="font-size:16px;line-height:1.3;">{{ 'product.spec_tiles.tile2_l1' | t }}<br>{{ 'product.spec_tiles.tile2_l2' | t }}</span><span class="spec-tile-lbl">{{ 'product.spec_tiles.tile2_label' | t }}</span></div>
            <div class="spec-tile"><span class="spec-tile-val" style="font-size:16px;line-height:1.3;">{{ 'product.spec_tiles.tile3_l1' | t }}<br>{{ 'product.spec_tiles.tile3_l2' | t }}</span><span class="spec-tile-lbl">{{ 'product.spec_tiles.tile3_label' | t }}</span></div>
          </div>
          <div class="spec-rows">
            {% for pt in product.metafields.specs %}
              <div class="spec-row"><span class="spec-key">{{ pt.key }}</span><span class="spec-val">{{ pt.value }}</span></div>
            {% else %}
              <div class="spec-row"><span class="spec-key">{{ 'product.spec_rows.pattern_label' | t }}</span><span class="spec-val">{{ 'product.spec_rows.pattern_val' | t }}</span></div>
              <div class="spec-row"><span class="spec-key">{{ 'product.spec_rows.size_label' | t }}</span><span class="spec-val">{{ 'product.spec_rows.size_val' | t }}</span></div>
              <div class="spec-row"><span class="spec-key">{{ 'product.spec_rows.closure_label' | t }}</span><span class="spec-val">{{ 'product.spec_rows.closure_val' | t }}</span></div>
              <div class="spec-row"><span class="spec-key">{{ 'product.spec_rows.packaging_label' | t }}</span><span class="spec-val">{{ 'product.spec_rows.packaging_val' | t }}</span></div>
            {% endfor %}
          </div>
          <p class="p-fit-copy">{{ 'product.fit_panel.p1' | t }}</p>
          <p class="p-fit-copy">{{ 'product.fit_panel.p2' | t }}</p>
        </div>
        <div class="p-tab-panel" data-panel="care">
          <p class="p-care-intro">{{ 'product.care_panel.intro' | t }}</p>
          <ul class="p-care-list">
            <li>{{ 'product.care_panel.item1' | t }}</li>
            <li>{{ 'product.care_panel.item2' | t }}</li>
            <li>{{ 'product.care_panel.item3' | t }}</li>
            <li>{{ 'product.care_panel.item4' | t }}</li>
          </ul>
        </div>
        <div class="p-tab-panel" data-panel="ship">
          <p>{{ 'product.shipping_panel.p1' | t }}</p>
          <p class="p-freeship-note">{{ 'general.freeship_note' | t }}</p>
          <h4 class="p-returns-title">{{ 'product.shipping_panel.returns_title' | t }}</h4>
          <p>{{ 'product.shipping_panel.returns_p1' | t }}</p>
          <p>{{ 'product.shipping_panel.returns_p2' | t }}</p>
          <p>{{ 'product.shipping_panel.returns_p3' | t }}</p>
        </div>
        <div class="p-tab-panel" data-panel="contact">
          <p>{{ 'product.contact_panel.prefix' | t }} <a href="mailto:saintorigin26@gmail.com" style="color:var(--green);border-bottom:1px solid var(--line-m);">saintorigin26@gmail.com</a>.</p>
        </div>
      </div>
    </div>
  </div>
</div>
