<div class="wrap subhead"><p class="eyebrow">{{ 'faq.eyebrow' | t }}</p><h1>{{ 'faq.title' | t }}</h1></div>
<div class="wrap faq-list">
  {%- assign faq_keys = "1,2,3,4,5" | split: "," -%}
  {% for n in faq_keys %}
    <div class="faq-item">
      <div class="faq-trigger"><div class="faq-q"><span>{{ 'faq.q' | append: n | t }}</span><span class="faq-plus">+</span></div></div>
      <div class="faq-a"><div class="faq-a-inner"><p>{{ 'faq.a' | append: n | t }}</p></div></div>
    </div>
  {% endfor %}
</div>
