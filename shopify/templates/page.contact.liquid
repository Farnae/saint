<div class="wrap subhead"><p class="eyebrow">{{ 'contact.eyebrow' | t }}</p><h1>{{ 'contact.title' | t }}</h1></div>
<div class="wrap contact-page">
  <p class="contact-intro">{{ 'contact.intro' | t }}</p>
  <div class="contact-rows">
    <div class="contact-row">
      <span class="contact-label">{{ 'contact.email_label' | t }}</span>
      <a href="mailto:saintorigin26@gmail.com" class="contact-value">saintorigin26@gmail.com</a>
    </div>
    <div class="contact-row">
      <span class="contact-label">{{ 'contact.instagram_label' | t }}</span>
      <a href="https://instagram.com/saint.origine" target="_blank" rel="noopener" class="contact-value">@saint.origine</a>
    </div>
    <div class="contact-row">
      <span class="contact-label">{{ 'contact.address_label' | t }}</span>
      <span class="contact-value">20 rue du Bel Air, 95110 Sannois, France</span>
    </div>
  </div>
</div>
