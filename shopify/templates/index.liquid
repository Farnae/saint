{%- comment -%}
  Cherche d'abord le produit sous son nouveau lien "bonnet-saint-eventail".
  S'il n'existe pas encore (produit pas encore renomm&eacute; dans l'admin),
  retombe automatiquement sur l'ancien lien "bonnet-saint-uroko" pour que
  la page d'accueil ne casse jamais, m&ecirc;me pendant la transition.
  Une fois le produit renomm&eacute; dans Shopify (Produits > ton bonnet >
  sous le titre > "Modifier le lien du site web" > bonnet-saint-eventail),
  tout se met &agrave; jour tout seul, rien &agrave; faire ici.
{%- endcomment -%}
{% assign product = all_products['bonnet-saint-eventail'] | default: all_products['bonnet-saint-uroko'] %}

<section class="hero">
  <div class="hero-copy">
    <p class="hero-kicker fade-up">{{ 'index.hero.kicker' | t }}</p>
    <h1>{{ 'index.hero.title_l1' | t }}<br><em>{{ 'index.hero.title_em' | t }}</em></h1>
    <p class="hero-sub fade-up d3">{{ 'index.hero.sub' | t }}</p>
    <div class="hero-actions fade-up d4">
      <a class="btn-primary" href="{{ product.url }}"><div class="btn-fill"></div><span>{{ 'index.hero.cta_discover' | t }}</span></a>
      <a href="#maison" class="btn-ghost">{{ 'index.hero.cta_story' | t }}</a>
    </div>
    <p class="hero-edition fade-up d5">{{ 'index.hero.edition' | t }}</p>
  </div>
  <div class="hero-visual">
    <div class="hpf"><img id="hero-cap" class="cap-hero" src="{{ product.images[2] | image_url: width: 1600 | default: product.featured_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}"></div>
  </div>
</section>

{% capture strip_group %}<span>{{ 'index.strip.wool' | t }}</span><span>&middot;</span><span>{{ 'index.strip.acrylic' | t }}</span><span>&middot;</span><span>{{ 'index.strip.embroidery' | t }}</span><span>&middot;</span><span>{{ 'index.strip.medallion' | t }}</span><span>&middot;</span><span>{{ 'index.strip.finish' | t }}</span><span>&middot;</span>{% endcapture %}
<div class="strip">
  <div class="strip-inner">
    {{ strip_group }}
    {{ strip_group }}
  </div>
</div>

<section class="story wrap reveal" id="maison">
  <div>
    <h2 data-split>{{ 'index.story.title_l1' | t }}<br>{{ 'index.story.title_l2' | t }}</h2>
  </div>
  <div class="story-right">
    <p>{{ 'index.story.p1' | t }}</p>
    <div class="srule"></div>
    <p>{{ 'index.story.p2' | t }}</p>
    <div class="srule"></div>
    <p>{{ 'index.story.p3' | t }}</p>
  </div>
</section>

{%- comment -%}
  Bannière lifestyle : uploade ta photo dans l'admin Shopify (Contenu > Fichiers,
  ou directement dans le dossier Assets du thème) sous le nom EXACT
  "saint-lifestyle-01.jpg" et elle apparaîtra ici automatiquement.
{%- endcomment -%}
<div class="editorial-break" id="editorial-break">
  <img src="{{ 'saint-lifestyle-01.jpg' | asset_url }}" alt="{{ 'index.editorial.alt' | t }}" loading="eager" fetchpriority="high">
</div>

<div class="lookbook-wrap reveal" aria-label="{{ 'index.lookbook.aria' | t }}">
  <div class="lookbook-track">
    {% for image in product.images %}
      <div class="lookbook-slide"><img src="{{ image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" {% if forloop.first %}fetchpriority="high"{% endif %}><span class="lookbook-caption">{{ 'index.lookbook.view' | t }} {{ forloop.index }}</span></div>
    {% endfor %}
    {% comment %} duplicat pour boucle infinie du marquee {% endcomment %}
    {% for image in product.images %}
      <div class="lookbook-slide" aria-hidden="true"><img src="{{ image | image_url: width: 1200 }}" alt="" loading="lazy"><span class="lookbook-caption">{{ 'index.lookbook.view' | t }} {{ forloop.index }}</span></div>
    {% endfor %}
  </div>
</div>

<section class="feature wrap reveal">
  <div class="feature-visual">
    <div class="img-reveal">
      <div class="gallery" data-lenis-prevent>
        {% for image in product.images limit: 4 %}
          <div class="gallery-slide"><div><img src="{{ image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:contain;"></div><span class="slide-label">{{ 'index.lookbook.view' | t }} {{ forloop.index }}</span></div>
        {% endfor %}
      </div>
    </div>
    <div class="gdots">
      {% for image in product.images limit: 4 %}
        <span{% if forloop.first %} class="active"{% endif %}></span>
      {% endfor %}
    </div>
  </div>
  <div class="feature-copy">
    <h2 data-split>{{ product.title }}</h2>
    <p class="feature-desc">{{ product.description | strip_html | truncate: 180 }}</p>
    <div class="feature-meta">
      <span class="feature-price">{{ product.price | money }}</span>
      <span class="fsep"></span>
      <span class="fmeta-txt">{{ 'index.hero.edition' | t }}</span>
    </div>
    <div class="float-badge">{% if product.available %}{{ 'index.feature.preorder' | t }}{% else %}{{ 'index.feature.soldout' | t }}{% endif %}</div>
    <a class="btn-primary" href="{{ product.url }}"><div class="btn-fill"></div><span>{{ 'index.hero.cta_discover' | t }}</span></a>
  </div>
</section>

<section class="uroko-sect" style="--uroko-texture:url('{{ 'uroko-detail.png' | asset_url }}');">
  <div class="wrap uroko-grid">
    <div class="uroko-motif reveal">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="uroko-tile" width="50" height="43.3" patternUnits="userSpaceOnUse">
            <path d="M0,43.3 A25,25 0 0,1 50,43.3"/>
            <path d="M-25,21.65 A25,25 0 0,1 25,21.65"/>
            <path d="M25,21.65 A25,25 0 0,1 75,21.65"/>
          </pattern>
        </defs>
        <rect width="200" height="200" fill="url(#uroko-tile)"/>
      </svg>
    </div>
    <div class="uroko-copy reveal reveal-delay-1">
      <p class="slabel">{{ 'index.uroko.label' | t }}</p>
      <h2 data-split>{{ 'index.uroko.title' | t }}</h2>
      <p>{{ 'index.uroko.p1' | t }}</p>
      <p>{{ 'index.uroko.p2' | t }}</p>
    </div>
  </div>
</section>

<section class="turntable-sect">
  <div class="turntable-intro wrap reveal">
    <p class="slabel">{{ 'index.turntable.label' | t }}</p>
    <h2 data-split>{{ 'index.turntable.title_l1' | t }}<br>{{ 'index.turntable.title_l2' | t }}</h2>
    <p>{{ 'index.turntable.p' | t }}</p>
  </div>
  <div class="turntable-wrap">
    <video class="turntable-media" src="{{ 'uroko-360.mp4' | asset_url }}" poster="{{ 'beanie-001.jpg' | asset_url }}" autoplay loop muted playsinline preload="metadata"></video>
    <div class="turntable-caption">{{ 'index.turntable.caption' | t }}</div>
  </div>
</section>

<section class="manifesto">
  <div class="manifesto-line reveal"><h3>{{ 'index.manifesto.l1' | t }}</h3></div>
  <div class="manifesto-line reveal"><h3>{{ 'index.manifesto.l2' | t }}</h3></div>
  <div class="manifesto-line reveal"><h3>{{ 'index.manifesto.l3' | t }}</h3></div>
</section>

<section class="matiere" id="matieres">
  <div class="wrap">
    <div class="mat-head reveal">
      <h2 data-split>{{ 'index.materials.title_l1' | t }}<br>{{ 'index.materials.title_l2' | t }}</h2>
      <p class="mat-intro">{{ 'index.materials.intro' | t }}</p>
    </div>
  </div>
  <div class="mat-row wrap reveal">
    <div class="mat-visual"><img src="{{ 'mat-wool-knit.jpg' | asset_url }}" alt="{{ 'index.materials.mat1_alt' | t }}" loading="lazy"></div>
    <div class="mat-copy">
      <span class="mat-tile-num">01</span>
      <h4>{{ 'index.materials.mat1_title' | t }}</h4>
      <p>{{ 'index.materials.mat1_desc' | t }}</p>
    </div>
  </div>
  <div class="mat-row mat-row-rev wrap reveal">
    <div class="mat-visual"><img src="{{ 'mat-beanie-studio.jpg' | asset_url }}" alt="{{ 'index.materials.mat2_alt' | t }}" loading="lazy"></div>
    <div class="mat-copy">
      <span class="mat-tile-num">02</span>
      <h4>{{ 'index.materials.mat2_title' | t }}</h4>
      <p>{{ 'index.materials.mat2_desc' | t }}</p>
    </div>
  </div>
  <div class="mat-row wrap reveal">
    <div class="mat-visual"><img src="{{ 'uroko-detail.png' | asset_url }}" alt="{{ 'index.materials.mat3_alt' | t }}" loading="lazy"></div>
    <div class="mat-copy">
      <span class="mat-tile-num">03</span>
      <h4>{{ 'index.materials.mat3_title' | t }}</h4>
      <p>{{ 'index.materials.mat3_desc' | t }}</p>
    </div>
  </div>
</section>

<section class="cta reveal">
  <div class="wrap cta-grid">
    <h2 data-split>{{ 'index.cta.title_l1' | t }}<br><em>{{ 'index.cta.title_em_l1' | t }}<br>{{ 'index.cta.title_em_l2' | t }}</em></h2>
    <div class="cta-right">
      <p class="cta-sub">{{ 'index.cta.sub' | t }}</p>
      {% form 'customer' %}
        {% if form.posted_successfully? %}
          <p class="cta-success">{{ 'index.cta.success' | t }}</p>
        {% elsif form.errors %}
          <p class="cta-error">{% if form.errors.messages['form'] %}{{ form.errors.messages['form'] }}{% else %}{{ 'index.cta.error_default' | t }}{% endif %}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="cta-form">
            <input type="email" name="contact[email]" placeholder="{{ 'index.cta.email_placeholder' | t }}" required>
            <button type="submit">{{ 'index.cta.submit' | t }}</button>
          </div>
        {% endif %}
      {% endform %}
      <p class="cta-note">{{ 'index.cta.note' | t }}</p>
    </div>
  </div>
</section>
