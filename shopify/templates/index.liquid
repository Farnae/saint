{%- comment -%}
  On prend le premier produit publi&eacute; de la boutique plut&ocirc;t qu'un
  handle en dur : &ccedil;a survit &agrave; un changement de nom/handle dans
  l'admin sans casser les liens "D&eacute;couvrir la pi&egrave;ce".
{%- endcomment -%}
{% assign product = collections.all.products.first %}
{% assign buy_variant = product.selected_or_first_available_variant %}
{% assign product_link = product.url | default: routes.all_products_collection_url | default: '/collections/all' %}
{% assign cap_images = "saint-look-01.webp,saint-look-02.webp,saint-look-03.webp,saint-look-04.webp" | split: "," %}
{% assign product_shots = "saint-cap-front.webp,saint-cap-side.webp,saint-cap-texture.webp,saint-cap-interior.webp" | split: "," %}

<section class="home-banner" aria-label="SAINT Origine">
  <img class="home-banner-img" src="{{ 'saint-banner-duo.webp' | asset_url }}" alt="{{ 'index.editorial.alt' | t }}" width="2560" height="1441" fetchpriority="high">
  <div class="home-banner-overlay">
    <img class="home-banner-logo" src="{{ 'saint-logo.svg' | asset_url }}" alt="SAINT Origine" width="2030" height="574">
    <a class="home-banner-cta" href="{{ product_link }}">{{ 'index.buy.banner_cta' | t }}</a>
  </div>
</section>

<section class="hero hero--after-banner" id="piece">
  <div class="hero-copy">
    <p class="hero-kicker">{{ 'index.hero.kicker' | t }}</p>
    <h1>{{ 'index.hero.title_l1' | t }}<br><em>{{ 'index.hero.title_em' | t }}</em></h1>
    <p class="hero-sub">{{ 'index.hero.sub' | t }}</p>
    <div class="buy-box">
      <div class="buy-line">
        <span class="buy-name">{{ product.title | default: "Casquette SAINT &Eacute;ventail" }}</span>
        <span class="buy-price">{{ product.price | money }}</span>
      </div>
      {%- if product.available -%}<p class="buy-stock"><span class="buy-dot" aria-hidden="true"></span>{{ 'index.buy.in_stock' | t }}</p>{%- endif -%}
      <div class="hero-actions">
      {%- if product and product.available -%}
        {% form 'product', product, class: 'buy-form' %}
          <input type="hidden" name="id" value="{{ buy_variant.id }}">
          <button type="submit" class="btn-primary btn-add-cart"><div class="btn-fill"></div><span>{{ 'index.buy.add_to_cart' | t }}</span></button>
        {% endform %}
      {%- else -%}
        <a class="btn-primary" href="{{ product_link }}"><div class="btn-fill"></div><span>{{ 'index.hero.cta_discover' | t }}</span></a>
      {%- endif -%}
        <a href="{{ product_link }}" class="btn-ghost">{{ 'index.buy.details' | t }}</a>
      </div>
      <ul class="buy-reassure">
        <li>{{ 'index.buy.reassure_ship' | t }}</li>
        <li>{{ 'index.buy.reassure_returns' | t }}</li>
        <li>{{ 'index.buy.reassure_pay' | t }}</li>
      </ul>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hpf"><img id="hero-cap" class="cap-hero" src="{{ 'saint-photo-eventail.webp' | asset_url }}" alt="Casquette SAINT &Eacute;ventail et son &eacute;ventail" loading="lazy"></div>
  </div>
</section>

<section class="feature wrap reveal">
  <div class="feature-visual">
    <div class="img-reveal">
      <div class="gallery" data-lenis-prevent>
        {% for image in product_shots %}
          <div class="gallery-slide"><div><img src="{{ image | asset_url }}" alt="Casquette SAINT &Eacute;ventail" loading="lazy" style="width:100%;height:100%;object-fit:contain;"></div><span class="slide-label">{{ 'index.lookbook.view' | t }} {{ forloop.index }}</span></div>
        {% endfor %}
      </div>
    </div>
    <div class="gdots">
      {% for image in product_shots %}
        <span{% if forloop.first %} class="active"{% endif %}></span>
      {% endfor %}
    </div>
  </div>
  <div class="feature-copy">
    <h2 data-split>{{ product.title | default: "Casquette SAINT &Eacute;ventail" }}</h2>
    <p class="feature-desc">{% assign feature_desc = product.description | strip_html | truncate: 180 %}{{ feature_desc | default: "Toile jacquard motif Uroko, structure souple et d&eacute;structur&eacute;e qui &eacute;pouse naturellement la forme du cr&acirc;ne. Une pi&egrave;ce faite pour durer." }}</p>
    <div class="feature-meta">
      <span class="feature-price">{{ product.price | money }}</span>
      <span class="fsep"></span>
      <span class="fmeta-txt">{{ 'index.hero.edition' | t }}</span>
    </div>
    <div class="float-badge">{% if product.available %}{{ 'index.buy.in_stock' | t }}{% else %}{{ 'index.feature.soldout' | t }}{% endif %}</div>
    <div class="hero-actions">
      {%- if product and product.available -%}
        {% form 'product', product, class: 'buy-form' %}
          <input type="hidden" name="id" value="{{ buy_variant.id }}">
          <button type="submit" class="btn-primary btn-add-cart"><div class="btn-fill"></div><span>{{ 'index.buy.add_to_cart' | t }}</span></button>
        {% endform %}
      {%- else -%}
        <a class="btn-primary" href="{{ product_link }}"><div class="btn-fill"></div><span>{{ 'index.hero.cta_discover' | t }}</span></a>
      {%- endif -%}
      </div>
  </div>
</section>

<div class="lookbook-wrap reveal" aria-label="{{ 'index.lookbook.aria' | t }}">
  <div class="lookbook-track">
    {% for image in cap_images %}
      <div class="lookbook-slide"><img src="{{ image | asset_url }}" alt="Casquette SAINT &Eacute;ventail port&eacute;e" loading="lazy"></div>
    {% endfor %}
    {% comment %} duplicat pour boucle infinie du marquee {% endcomment %}
    {% for image in cap_images %}
      <div class="lookbook-slide" aria-hidden="true"><img src="{{ image | asset_url }}" alt="" loading="lazy"></div>
    {% endfor %}
  </div>
</div>

<section class="story wrap reveal" id="maison">
  <div>
    <h2 data-split>{{ 'index.story.title_l1' | t }}<br>{{ 'index.story.title_l2' | t }}</h2>
  </div>
  <div class="story-right">
    <p>{{ 'index.story.p1' | t }}</p>
    <div class="srule"></div>
    <p>{{ 'index.story.p2' | t }}</p>
    <div class="srule"></div>
    <p>{{ 'index.story.p3' | t }}</p>
  </div>
</section>

<section class="signature-sect" id="matieres">
  <div class="signature-head wrap reveal">
    <h2 data-split>{{ 'index.materials.title_l1' | t }}<br>{{ 'index.materials.title_l2' | t }}</h2>
    <p class="mat-intro">{{ 'index.materials.intro' | t }}</p>
  </div>
  <div class="signature-visual">
    <img src="{{ 'saint-jacquard-signature.webp' | asset_url }}" alt="{{ 'index.materials.mat1_alt' | t }}" width="1917" height="1441" loading="lazy">
  </div>
</section>

<section class="uroko-sect" style="--uroko-texture:url('{{ 'uroko-detail.png' | asset_url }}');">
  <div class="wrap uroko-grid">
    <div class="uroko-motif reveal">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="uroko-tile" width="50" height="43.3" patternUnits="userSpaceOnUse">
            <path d="M0,43.3 A25,25 0 0,1 50,43.3"/>
            <path d="M-25,21.65 A25,25 0 0,1 25,21.65"/>
            <path d="M25,21.65 A25,25 0 0,1 75,21.65"/>
          </pattern>
        </defs>
        <rect width="200" height="200" fill="url(#uroko-tile)"/>
      </svg>
    </div>
    <div class="uroko-copy reveal reveal-delay-1">
      <p class="slabel">{{ 'index.uroko.label' | t }}</p>
      <h2 data-split>{{ 'index.uroko.title' | t }}</h2>
      <p>{{ 'index.uroko.p1' | t }}</p>
      <p>{{ 'index.uroko.p2' | t }}</p>
    </div>
  </div>
</section>

<section class="manifesto">
  <div class="manifesto-line reveal"><h3>{{ 'index.manifesto.l1' | t }}</h3></div>
  <div class="manifesto-line reveal"><h3>{{ 'index.manifesto.l2' | t }}</h3></div>
  <div class="manifesto-line reveal"><h3>{{ 'index.manifesto.l3' | t }}</h3></div>
</section>

<section class="cta reveal">
  <div class="wrap cta-grid">
    <h2 data-split>{{ 'index.cta.title_l1' | t }}<br><em>{{ 'index.cta.title_em_l1' | t }}<br>{{ 'index.cta.title_em_l2' | t }}</em></h2>
    <div class="cta-right">
      <p class="cta-sub">{{ 'index.cta.sub' | t }}</p>
      {%- capture nl_msgs -%}{"empty":{{ 'general.newsletter.empty_email' | t | json }},"invalid":{{ 'general.newsletter.invalid_email' | t | json }},"success":{{ 'general.newsletter.success' | t | json }},"already":{{ 'general.newsletter.already' | t | json }},"error":{{ 'general.newsletter.error' | t | json }}}{%- endcapture -%}
      <div class="newsletter" data-newsletter="{{ nl_msgs | escape }}">
        {% form 'customer', id: 'newsletter-home' %}
          {% if form.posted_successfully? %}
            <p class="cta-success" data-newsletter-state="success">{{ 'general.newsletter.success' | t }}</p>
          {% elsif form.errors contains 'email' %}
            <p class="cta-success" data-newsletter-state="already">{{ 'general.newsletter.already' | t }}</p>
          {% else %}
            {% if form.errors %}
              <p class="cta-error" data-newsletter-state="error">{{ 'general.newsletter.error' | t }}</p>
            {% endif %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="cta-form" data-newsletter-field>
              <input type="email" name="contact[email]" placeholder="{{ 'index.cta.email_placeholder' | t }}" aria-label="{{ 'index.cta.email_placeholder' | t }}" autocomplete="email" inputmode="email">
              <button type="submit">{{ 'index.cta.submit' | t }}</button>
            </div>
            <p class="newsletter-hint" data-newsletter-hint aria-live="polite"></p>
          {% endif %}
        {% endform %}
      </div>
      <p class="cta-note">{{ 'index.cta.note' | t }}</p>
    </div>
  </div>
</section>

{%- if product and product.available -%}
<div class="buy-sticky" id="buy-sticky" aria-label="{{ 'index.buy.sticky_aria' | t }}" hidden>
  <div class="buy-sticky-info">
    <span class="buy-sticky-name">{{ product.title }}</span>
    <span class="buy-sticky-price">{{ product.price | money }}</span>
  </div>
  {% form 'product', product, class: 'buy-form' %}
    <input type="hidden" name="id" value="{{ buy_variant.id }}">
    <button type="submit" class="btn-add-cart buy-sticky-btn"><span>{{ 'index.buy.add_to_cart' | t }}</span></button>
  {% endform %}
</div>
{%- endif -%}
