<div class="pw-form-wrap">
  {% form 'storefront_password' %}
    {% if form.errors %}
      <p class="pw-error">Mot de passe incorrect. R&eacute;essayez.</p>
    {% endif %}
    <div class="pw-field">
      <input type="password" name="password" id="Password" placeholder="Mot de passe" autofocus required>
      <button type="submit"><span>Entrer</span></button>
    </div>
  {% endform %}
</div>
