{%- assign toast_text = '' -%}
{%- assign toast_type = '' -%}
{%- capture nl_msgs -%}{"empty":{{ 'general.newsletter.empty_email' | t | json }},"invalid":{{ 'general.newsletter.invalid_email' | t | json }},"success":{{ 'password.subscribed' | t | json }},"already":{{ 'password.already_subscribed' | t | json }},"error":{{ 'general.newsletter.error' | t | json }},"phone":{{ 'password.phone_invalid' | t | json }}}{%- endcapture -%}

<div class="pw-standalone">
  <a href="{{ routes.root_url }}" class="logo-link pw-logo" aria-label="SAINT Origine">{% render 'saint-logo' %}</a>

  <div class="pw-intro">
    <p class="pw-kicker">{{ 'password.kicker' | t }}</p>
    <h1 class="pw-title">{{ 'password.title' | t }}</h1>
    <p class="pw-sub">{{ 'password.sub' | t }}</p>
  </div>

  <div class="pw-form-wrap newsletter" data-newsletter="{{ nl_msgs | escape }}">
    {%- comment -%}
      Inscrit le client avec le tag "newsletter" (consentement marketing) et
      "liste-attente" pour pouvoir filtrer ces inscrits dans Admin > Clients
      le jour de la sortie.
    {%- endcomment -%}
    {% form 'customer', id: 'pw-notify' %}
      {%- comment -%}
        « Déjà inscrit » uniquement si Shopify dit que l'email est déjà utilisé.
        Toute autre erreur sur l'email (domaine refusé, adresse inexistante…)
        affiche un message d'erreur et laisse le formulaire pour réessayer.
      {%- endcomment -%}
      {%- assign email_err = '' -%}
      {%- if form.errors -%}{%- assign email_err = form.errors.messages['email'] | append: '' | downcase -%}{%- endif -%}
      {%- assign email_taken = false -%}
      {%- if email_err contains 'taken' or email_err contains 'déjà' or email_err contains 'utilis' -%}{%- assign email_taken = true -%}{%- endif -%}
      {% if form.posted_successfully? %}
        {%- assign toast_text = 'password.subscribed' | t -%}
        {%- assign toast_type = 'success' -%}
        <p class="cta-success pw-msg" data-newsletter-state="success">{{ 'password.subscribed' | t }}</p>
      {% elsif email_taken %}
        {%- assign toast_text = 'password.already_subscribed' | t -%}
        {%- assign toast_type = 'info' -%}
        <p class="cta-success pw-msg" data-newsletter-state="already">{{ 'password.already_subscribed' | t }}</p>
      {% else %}
        {% if form.errors %}
          {%- if email_err != '' -%}{%- assign toast_text = 'general.newsletter.rejected_email' | t -%}{%- else -%}{%- assign toast_text = 'general.newsletter.error' | t -%}{%- endif -%}
          {%- assign toast_type = 'error' -%}
          <span hidden data-newsletter-state="error"></span>
        {% endif %}
        <input type="hidden" name="contact[tags]" value="newsletter,liste-attente">
        <div class="pw-fields">
          <div class="pw-line">
            <label for="pw-notify-name">{{ 'password.first_name' | t }}</label>
            <input type="text" name="contact[first_name]" id="pw-notify-name" autocomplete="given-name">
          </div>
          <div class="pw-line" data-newsletter-field>
            <label for="pw-notify-email">{{ 'password.email_label' | t }}</label>
            <input type="email" required name="contact[email]" id="pw-notify-email" value="{{ form.email | escape }}" placeholder="vous@exemple.com" autocomplete="email" inputmode="email">
          </div>
          <div class="pw-line">
            <label for="pw-notify-phone">{{ 'password.phone_label' | t }}</label>
            <input type="tel" id="pw-notify-phone" data-phone pattern="[0-9 +().\-]{8,20}" title="{{ 'password.phone_invalid' | t | escape }}" placeholder="06 12 34 56 78" autocomplete="tel" inputmode="tel">
          </div>
          <label class="pw-consent"><input type="checkbox" data-sms> <span>{{ 'password.sms_consent' | t }}</span></label>
          <button type="submit" class="pw-submit"><span>{{ 'password.subscribe' | t }}</span></button>
        </div>
        <p class="newsletter-hint" data-newsletter-hint aria-live="polite"></p>
        <p class="pw-note">{{ 'password.note' | t }}</p>
      {% endif %}
    {% endform %}
  </div>

  <div class="pw-form-wrap pw-access">
    {% form 'storefront_password' %}
      <details{% if form.errors %} open{% endif %}>
        <summary>{{ 'password.access_toggle' | t }}</summary>
        {% if form.errors %}
          <p class="pw-error">{{ 'password.error' | t }}</p>
        {% endif %}
        <div class="pw-field">
          <label for="Password" class="visually-hidden">{{ 'password.placeholder' | t }}</label>
          <input type="password" name="password" id="Password" placeholder="{{ 'password.placeholder' | t }}" required>
          <button type="submit"><span>{{ 'password.submit' | t }}</span></button>
        </div>
      </details>
    {% endform %}
  </div>
</div>

{% render 'maison', signup_url: '#pw-notify' %}

{%- if toast_type != '' -%}
<div class="saint-toast is-{{ toast_type }} is-visible" id="saint-toast" role="status" aria-live="polite">
  <span class="saint-toast-icon" aria-hidden="true"></span>
  <span class="saint-toast-text">{{ toast_text }}</span>
</div>
{%- endif -%}
