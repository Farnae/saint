{%- assign pw_toast_text = '' -%}
{%- assign pw_toast_type = '' -%}

<div class="pw-standalone">
  <a href="{{ routes.root_url }}" class="wordmark-block pw-logo"><span class="wordmark">SAINT</span><span class="wordmark-sub">origine</span></a>

  <div class="pw-intro">
    <p class="pw-kicker">{{ 'password.kicker' | t }}</p>
    <h1 class="pw-title">{{ 'password.title' | t }}</h1>
    <p class="pw-sub">{{ 'password.sub' | t }}</p>
  </div>

  <div class="pw-form-wrap">
    {%- comment -%}
      Inscrit le client avec le tag "newsletter" (consentement marketing) et
      "liste-attente" pour pouvoir filtrer ces inscrits dans Admin > Clients
      le jour de la sortie.
    {%- endcomment -%}
    {% form 'customer', id: 'pw-notify' %}
      {% if form.posted_successfully? %}
        {%- assign pw_toast_text = 'password.subscribed' | t -%}
        {%- assign pw_toast_type = 'success' -%}
        <p class="cta-success pw-msg">{{ 'password.subscribed' | t }}</p>
      {% elsif form.errors contains 'email' %}
        {%- assign pw_toast_text = 'password.already_subscribed' | t -%}
        {%- assign pw_toast_type = 'info' -%}
        <p class="cta-success pw-msg">{{ 'password.already_subscribed' | t }}</p>
      {% else %}
        {% if form.errors %}
          {%- assign pw_toast_text = 'password.subscribe_error' | t -%}
          {%- assign pw_toast_type = 'error' -%}
        {% endif %}
        <input type="hidden" name="contact[tags]" value="newsletter,liste-attente">
        <div class="pw-field" id="pw-notify-field">
          <label for="pw-notify-email" class="visually-hidden">{{ 'password.email_placeholder' | t }}</label>
          <input type="email" name="contact[email]" id="pw-notify-email" placeholder="{{ 'password.email_placeholder' | t }}" autocomplete="email" inputmode="email" aria-describedby="pw-notify-hint">
          <button type="submit"><span>{{ 'password.subscribe' | t }}</span></button>
        </div>
        <p class="pw-field-hint" id="pw-notify-hint" aria-live="polite"></p>
        <p class="pw-note">{{ 'password.note' | t }}</p>
      {% endif %}
    {% endform %}
  </div>

  <div class="pw-form-wrap pw-access">
    {% form 'storefront_password' %}
      <details{% if form.errors %} open{% endif %}>
        <summary>{{ 'password.access_toggle' | t }}</summary>
        {% if form.errors %}
          <p class="pw-error">{{ 'password.error' | t }}</p>
        {% endif %}
        <div class="pw-field">
          <label for="Password" class="visually-hidden">{{ 'password.placeholder' | t }}</label>
          <input type="password" name="password" id="Password" placeholder="{{ 'password.placeholder' | t }}" required>
          <button type="submit"><span>{{ 'password.submit' | t }}</span></button>
        </div>
      </details>
    {% endform %}
  </div>
</div>

<div class="pw-toast{% if pw_toast_type != '' %} is-{{ pw_toast_type }} is-visible{% endif %}" id="pw-toast" role="status" aria-live="polite">
  <span class="pw-toast-icon" aria-hidden="true"></span>
  <span class="pw-toast-text">{{ pw_toast_text }}</span>
</div>

<script>
(function(){
  var form = document.getElementById('pw-notify');
  var toast = document.getElementById('pw-toast');
  var toastText = toast.querySelector('.pw-toast-text');
  var hideTimer;

  function showToast(message, type){
    clearTimeout(hideTimer);
    toast.className = 'pw-toast is-' + type;
    toastText.textContent = message;
    void toast.offsetWidth;
    toast.classList.add('is-visible');
    hideTimer = setTimeout(function(){ toast.classList.remove('is-visible'); }, 5000);
  }

  if (toast.classList.contains('is-visible')) {
    hideTimer = setTimeout(function(){ toast.classList.remove('is-visible'); }, 5000);
  }

  var input = form && form.querySelector('#pw-notify-email');
  if (!input) return;
  form.noValidate = true;
  var field = form.querySelector('#pw-notify-field');
  var hint = form.querySelector('#pw-notify-hint');
  var msgEmpty = {{ 'password.empty_email' | t | json }};
  var msgInvalid = {{ 'password.invalid_email' | t | json }};

  function setError(message){
    field.classList.toggle('has-error', !!message);
    hint.textContent = message || '';
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  input.addEventListener('input', function(){ if (field.classList.contains('has-error')) setError(''); });

  form.addEventListener('submit', function(e){
    var value = input.value.trim();
    var error = '';
    if (!value) error = msgEmpty;
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) error = msgInvalid;
    if (error) {
      e.preventDefault();
      setError(error);
      showToast(error, 'error');
      input.focus();
    }
  });
})();
</script>
