<div class="pw-standalone">
  <a href="{{ routes.root_url }}" class="wordmark-block pw-logo"><span class="wordmark">SAINT</span><span class="wordmark-sub">origine</span></a>
  <div class="pw-form-wrap">
    {% form 'storefront_password' %}
      {% if form.errors %}
        <p class="pw-error">{{ 'password.error' | t }}</p>
      {% endif %}
      <div class="pw-field">
        <input type="password" name="password" id="Password" placeholder="{{ 'password.placeholder' | t }}" autofocus required>
        <button type="submit"><span>{{ 'password.submit' | t }}</span></button>
      </div>
    {% endform %}
  </div>
</div>
