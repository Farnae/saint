<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#064829">
<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
<title>{{ shop.name }}</title>
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
{{ 'saint.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<main id="site-main">
  {{ content_for_layout }}
</main>
</body>
</html>
