<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#064829">
<title>{{ shop.name }}</title>
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
{{ 'saint.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<main class="pw-screen">
  <a href="{{ routes.root_url }}" class="wordmark-block pw-logo"><span class="wordmark">SAINT</span><span class="wordmark-sub">origine</span></a>
  <p class="pw-tagline">{{ shop.password_message | default: "Maison parisienne. Ouverture prochaine." }}</p>

  {{ content_for_layout }}

  <div class="pw-notify">
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="cta-form">
        <input type="email" name="contact[email]" placeholder="Votre adresse email" required>
        <button type="submit">Me pr&eacute;venir</button>
      </div>
    {% endform %}
    <p class="pw-note">Soyez averti&middot;e &agrave; l'ouverture. Sans spam.</p>
  </div>

  <p class="pw-contact">Une question&nbsp;? <a href="mailto:saintorigin26@gmail.com">saintorigin26@gmail.com</a></p>
</main>
{{ 'saint.js' | asset_url | script_tag }}
</body>
</html>
