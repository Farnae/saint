<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#064829">
<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
<title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{%- assign meta_description = page_description | default: shop.description | default: 'SAINT Origine, maison parisienne d’accessoires. Casquette Éventail en toile jacquard motif Uroko.' -%}
<meta name="description" content="{{ meta_description | strip_html | strip_newlines | truncate: 160 | escape }}">
{%- assign og_image = 'saint-banner-duo-1400.webp' | asset_url -%}
{%- if template.name == 'product' and product.featured_image -%}{%- assign og_image = product.featured_image | image_url: width: 1200 -%}{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:description" content="{{ meta_description | strip_html | strip_newlines | truncate: 160 | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:image" content="https:{{ og_image | remove: 'https:' }}">
{%- if template.name == 'product' -%}
<meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code | default: 'EUR' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;1,400&family=Jost:wght@300;400;500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
{{ 'saint.css' | asset_url | stylesheet_tag }}
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/split-type@0.3.4/umd/index.min.js" defer></script>
{{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
<a class="skip-link" href="#site-main">{{ 'general.skip_to_content' | t }}</a>

{% if template.name == 'index' %}
<div id="curtain"><img class="cw-logo" src="{{ 'saint-logo.svg' | asset_url }}" alt="SAINT Origine" width="3293" height="925"><div class="cline"></div></div>
{% endif %}

<header id="hdr">
  <a href="{{ routes.root_url }}" class="logo-link" aria-label="SAINT Origine">{% render 'saint-logo' %}</a>
  <div class="navmenu">
    <nav><ul>
      <li><a href="{{ routes.root_url }}" {% if template.name == 'index' %}class="current"{% endif %}>{{ 'general.nav.home' | t }}</a></li>
      <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" {% if template.name == 'collection' or template.name == 'list-collections' %}class="current"{% endif %}>{{ 'general.nav.collection' | t }}</a></li>
      <li><a href="/pages/faq" {% if template.name == 'page.faq' %}class="current"{% endif %}>{{ 'general.nav.faq' | t }}</a></li>
      <li><a href="/pages/contact" {% if template.name == 'page.contact' %}class="current"{% endif %}>{{ 'general.nav.contact' | t }}</a></li>
    </ul></nav>
    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <a class="account-link" href="{{ routes.account_url }}">{{ 'general.nav.account' | t }}</a>
      {% else %}
        <a class="account-link" href="{{ routes.account_login_url }}">{{ 'general.nav.login' | t }}</a>
      {% endif %}
    {% endif %}
    {% if localization.available_languages.size > 1 %}
      {% form 'localization', id: 'lang-form-desktop' %}
        <div class="lang-switch">
          {% for language in localization.available_languages %}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="lang-btn{% if language.iso_code == localization.language.iso_code %} active{% endif %}">{{ language.iso_code }}</button>
          {% endfor %}
        </div>
      {% endform %}
    {% endif %}
    <a class="bag" href="{{ routes.cart_url }}" id="cart-drawer-trigger">{{ 'general.nav.cart' | t }} <span class="cart-count">{{ cart.item_count }}</span></a>
  </div>
  <button class="cart-trigger-mobile" id="cart-drawer-trigger-mobile" aria-label="{{ 'general.nav.cart' | t }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
    <span class="cart-count">{{ cart.item_count }}</span>
  </button>
  <button class="burger" id="burger" aria-label="{{ 'general.nav.open_menu' | t }}" aria-expanded="false" aria-controls="mobile-nav">
    <span></span><span></span>
  </button>
</header>

<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  {%- assign nav_product = collections.all.products.first -%}
  <nav class="mnav-main"><ul>
    <li><a href="{{ routes.root_url }}" {% if template.name == 'index' %}class="current"{% endif %}><span>{{ 'general.nav.home' | t }}</span></a></li>
    <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" {% if template.name == 'collection' or template.name == 'list-collections' %}class="current"{% endif %}><span>{{ 'general.nav.collection' | t }}</span></a></li>
    <li><a href="/pages/faq" {% if template.name == 'page.faq' %}class="current"{% endif %}><span>{{ 'general.nav.faq' | t }}</span></a></li>
    <li><a href="/pages/contact" {% if template.name == 'page.contact' %}class="current"{% endif %}><span>{{ 'general.nav.contact' | t }}</span></a></li>
  </ul></nav>
  {%- if nav_product -%}
    <a class="mnav-product" href="{{ nav_product.url }}">
      {%- if nav_product.featured_image -%}<img src="{{ nav_product.featured_image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">{%- endif -%}
      <span class="mnav-product-txt">
        <span class="mnav-product-kicker">{{ 'general.mobile_nav.shop_title' | t }}</span>
        <span class="mnav-product-name">{{ nav_product.title }}</span>
        <span class="mnav-product-price">{{ nav_product.price | money }}</span>
      </span>
      <span class="mnav-product-cta">{{ 'general.mobile_nav.shop_cta' | t }} &rarr;</span>
    </a>
  {%- endif -%}
  <div class="mnav-meta">
    <a href="{{ routes.cart_url }}">{{ 'general.nav.cart' | t }} ({{ cart.item_count }})</a>
    {% if shop.customer_accounts_enabled %}
      {% if customer %}<a href="{{ routes.account_url }}">{{ 'general.nav.account' | t }}</a>{% else %}<a href="{{ routes.account_login_url }}">{{ 'general.nav.login' | t }}</a>{% endif %}
    {% endif %}
    {% if localization.available_languages.size > 1 %}
      {% form 'localization', id: 'lang-form-mobile' %}
        <div class="lang-switch lang-switch-mobile">
          {% for language in localization.available_languages %}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="lang-btn{% if language.iso_code == localization.language.iso_code %} active{% endif %}">{{ language.iso_code }}</button>
          {% endfor %}
        </div>
      {% endform %}
    {% endif %}
  </div>
</div>

<main id="site-main">
  {{ content_for_layout }}
</main>

<footer id="contact">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="{{ routes.root_url }}" class="logo-link" aria-label="SAINT Origine">{% render 'saint-logo' %}</a>
        <p>{{ 'general.footer.brand_desc' | t }}</p>
      </div>
      <div class="foot-col">
        <h5>{{ 'general.footer.shop_heading' | t }}</h5>
        <ul>
          <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ 'general.nav.collection' | t }}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h5>{{ 'general.footer.house_heading' | t }}</h5>
        <ul>
          <li><a href="{{ routes.root_url }}#maison">{{ 'general.footer.our_story' | t }}</a></li>
          <li><a href="/pages/faq">{{ 'general.nav.faq' | t }}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h5>{{ 'general.footer.contact_heading' | t }}</h5>
        <ul>
          <li><a href="/pages/contact">{{ 'general.nav.contact' | t }}</a></li>
          <li>
            <a href="https://instagram.com/saint.origine" target="_blank" rel="noopener" class="ig-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1"/></svg>
              <span>saint.origine</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    {%- comment -%}
      Pages légales (gérées dans Paramètres > Politiques). Elles n'apparaissent
      qu'une fois sur le site : la page mot de passe n'utilise pas ce footer.
      Volontairement sans "Coordonnées", qui afficherait l'adresse personnelle.
    {%- endcomment -%}
    {%- if shop.terms_of_service or shop.privacy_policy or shop.refund_policy or shop.shipping_policy -%}
      <nav class="foot-legal" aria-label="{{ 'general.footer.legal_heading' | t }}">
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
        {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
    <div class="foot-bottom">
      {% assign current_year = 'now' | date: '%Y' %}
      <span>{{ 'general.footer.copyright' | t: year: current_year }}</span>
      <span>{{ 'general.footer.location' | t }}</span>
    </div>
  </div>
</footer>

<div class="cart-drawer-backdrop" id="cart-drawer-backdrop"></div>
<aside class="cart-drawer" id="cart-drawer" aria-hidden="true">
  <div class="cart-drawer-head">
    <h3>{{ 'cart.title' | t }}</h3>
    <button class="cart-drawer-close" id="cart-drawer-close" aria-label="{{ 'cart.close_aria' | t }}">&times;</button>
  </div>
  <div class="cart-drawer-body" id="cart-drawer-body"></div>
  <div class="cart-drawer-foot" id="cart-drawer-foot"></div>
</aside>

<script>
window.SAINT_I18N = {
  added: {{ 'general.cart_js.added' | t | json }},
  cartEmpty: {{ 'cart.empty_text' | t | json }},
  freeship: {{ 'general.freeship_note' | t | json }},
  freeShipThreshold: 15000,
  subtotal: {{ 'cart.subtotal' | t | json }},
  total: {{ 'cart.total' | t | json }},
  checkout: {{ 'cart.checkout' | t | json }},
  checkoutUrl: {{ '/checkout' | json }},
  remove: {{ 'cart.remove' | t | json }},
  addError: {{ 'general.cart_js.add_error' | t | json }},
  shippingNote: {{ 'cart.shipping_note' | t | json }},
  viewCart: {{ 'cart.view_cart' | t | json }},
  cartUrl: {{ routes.cart_url | json }},
  viewCollection: {{ 'cart.view_collection' | t | json }},
  collectionUrl: {{ routes.all_products_collection_url | default: '/collections/all' | json }}
};
</script>
<script src="{{ 'saint.js' | asset_url }}" defer></script>
<script src="{{ 'newsletter.js' | asset_url }}" defer></script>
</body>
</html>
