<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#064829">
<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
<title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
{{ 'saint.css' | asset_url | stylesheet_tag }}
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/split-type@0.3.4/umd/index.min.js"></script>
{{ content_for_header }}
</head>
<body>

<div class="scroll-progress" aria-hidden="true"></div>
{% if template.name == 'index' %}
<div id="curtain"><span class="cw">SAINT</span><span class="cw-sub">origine</span><div class="cline"></div></div>
{% endif %}

<header id="hdr">
  <a href="{{ routes.root_url }}" class="wordmark-block"><span class="wordmark">SAINT</span><span class="wordmark-sub">origine</span></a>
  <div class="navmenu">
    <nav><ul>
      <li><a href="{{ routes.root_url }}" {% if template.name == 'index' %}class="current"{% endif %}>{{ 'general.nav.home' | t }}</a></li>
      <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" {% if template.name == 'collection' or template.name == 'list-collections' %}class="current"{% endif %}>{{ 'general.nav.collection' | t }}</a></li>
      <li><a href="/pages/faq" {% if template.name == 'page.faq' %}class="current"{% endif %}>{{ 'general.nav.faq' | t }}</a></li>
      <li><a href="{{ routes.root_url }}#contact">{{ 'general.nav.contact' | t }}</a></li>
    </ul></nav>
    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <a class="account-link" href="{{ routes.account_url }}">{{ 'general.nav.account' | t }}</a>
      {% else %}
        <a class="account-link" href="{{ routes.account_login_url }}">{{ 'general.nav.login' | t }}</a>
      {% endif %}
    {% endif %}
    {% if localization.available_languages.size > 1 %}
      {% form 'localization', id: 'lang-form-desktop' %}
        <div class="lang-switch">
          {% for language in localization.available_languages %}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="lang-btn{% if language.iso_code == localization.language.iso_code %} active{% endif %}">{{ language.iso_code }}</button>
          {% endfor %}
        </div>
      {% endform %}
    {% endif %}
    <a class="bag" href="{{ routes.cart_url }}">{{ 'general.nav.cart' | t }} <span id="cart-count">{{ cart.item_count }}</span></a>
  </div>
  <button class="burger" id="burger" aria-label="{{ 'general.nav.open_menu' | t }}" aria-expanded="false" aria-controls="mobile-nav">
    <span></span><span></span>
  </button>
</header>

<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <nav><ul>
    <li><a href="{{ routes.root_url }}" {% if template.name == 'index' %}class="current"{% endif %}><span>{{ 'general.nav.home' | t }}</span></a></li>
    <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" {% if template.name == 'collection' or template.name == 'list-collections' %}class="current"{% endif %}><span>{{ 'general.nav.collection' | t }}</span></a></li>
    <li><a href="/pages/faq" {% if template.name == 'page.faq' %}class="current"{% endif %}><span>{{ 'general.nav.faq' | t }}</span></a></li>
    <li><a href="{{ routes.root_url }}#contact"><span>{{ 'general.nav.contact' | t }}</span></a></li>
    <li><a href="{{ routes.cart_url }}"><span>{{ 'general.nav.cart' | t }} ({{ cart.item_count }})</span></a></li>
    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <li><a href="{{ routes.account_url }}"><span>{{ 'general.nav.account' | t }}</span></a></li>
      {% else %}
        <li><a href="{{ routes.account_login_url }}"><span>{{ 'general.nav.login' | t }}</span></a></li>
      {% endif %}
    {% endif %}
    {% if localization.available_languages.size > 1 %}
      <li>
        {% form 'localization', id: 'lang-form-mobile' %}
          <div class="lang-switch lang-switch-mobile">
            {% for language in localization.available_languages %}
              <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="lang-btn{% if language.iso_code == localization.language.iso_code %} active{% endif %}">{{ language.iso_code }}</button>
            {% endfor %}
          </div>
        {% endform %}
      </li>
    {% endif %}
  </ul></nav>
  <p class="mobile-nav-foot">{{ 'general.mobile_nav.footer' | t }}</p>
</div>

<main id="site-main">
  {{ content_for_layout }}
</main>

<footer id="contact">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="{{ routes.root_url }}" class="wordmark-block"><span class="wordmark">SAINT</span><span class="wordmark-sub">origine</span></a>
        <p>{{ 'general.footer.brand_desc' | t }}</p>
      </div>
      <div class="foot-col">
        <h5>{{ 'general.footer.shop_heading' | t }}</h5>
        <ul>
          <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ 'general.nav.collection' | t }}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h5>{{ 'general.footer.house_heading' | t }}</h5>
        <ul>
          <li><a href="{{ routes.root_url }}#maison">{{ 'general.footer.our_story' | t }}</a></li>
          <li><a href="/pages/faq">{{ 'general.nav.faq' | t }}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h5>{{ 'general.footer.contact_heading' | t }}</h5>
        <ul>
          <li><a href="mailto:saintorigin26@gmail.com">saintorigin26@gmail.com</a></li>
          <li>
            <a href="https://instagram.com/saint.origine" target="_blank" rel="noopener" class="ig-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1"/></svg>
              <span>saint.origine</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      {% assign current_year = 'now' | date: '%Y' %}
      <span>{{ 'general.footer.copyright' | t: year: current_year }}</span>
      <span>{{ 'general.footer.location' | t }}</span>
    </div>
  </div>
</footer>

<script>window.SAINT_I18N = { added: {{ 'general.cart_js.added' | t | json }} };</script>
{{ 'saint.js' | asset_url | script_tag }}
</body>
</html>
